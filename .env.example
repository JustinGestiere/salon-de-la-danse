# Base de données PostgreSQL (Prisma 7 : l'URL est lue par prisma.config.ts et par lib/db.ts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salon_de_la_danse?schema=public"

# Better Auth
# Secret utilisé pour signer les sessions (32 caractères minimum). L'application
# refuse de démarrer avec la valeur d'exemple ci-dessous. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# URL publique de l'application (exposée au navigateur)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dossier de stockage des photos d'identité (hors du repo, hors de public/)
UPLOAD_DIR="./storage/photos"

# Envoi des e-mails (lien de réinitialisation du mot de passe). Obligatoire en
# production, avec MAIL_FROM identique au compte SMTP (OVH refuse sinon).
# Exemple OVH Zimbra : SMTP_HOST="smtp.mail.ovh.net", SMTP_PORT="465",
# SMTP_USER="adresse@domaine.fr", SMTP_PASSWORD="mot de passe de l'adresse".
# En local, un piège à e-mails comme Mailpit suffit (sans identifiants) :
#   docker run -p 8025:8025 -p 1025:1025 axllent/mailpit  (boîte sur http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASSWORD=""
MAIL_FROM="Salon de la Danse <ne-pas-repondre@localhost>"
