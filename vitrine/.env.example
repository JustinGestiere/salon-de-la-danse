# URL publique du site vitrine : sert aux liens de retour après paiement.
SITE_URL="http://localhost:3001"

# Stripe (tableau de bord > Développeurs > Clés API). Clé secrète de test en
# local (sk_test_…). Sans elle, le site fonctionne mais la billetterie affiche
# « paiement en ligne indisponible ».
# STRIPE_SECRET_KEY="sk_test_..."

# Vente privée de J-90 (licenciés FFDanse et écoles) : code à leur transmettre.
# PRIVATE_SALE_ACCESS_CODE="..."

# Développement uniquement : simule une date pour tester les phases de vente
# (vente privée 14-15 février 2027, Early Bird à partir du 31 mars, plein
# tarif à partir du 15 avril). Ignoré en production.
# TICKETING_CLOCK_OVERRIDE="2027-04-01T10:00:00Z"
